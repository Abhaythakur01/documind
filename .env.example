# ─── Groq API (free tier at https://console.groq.com) ────────────────────────
GROQ_API_KEY=

# ─── LangSmith (free tier at https://smith.langchain.com) ────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=documind

# ─── Qdrant (vector store) ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documind

# ─── Model routing (Groq free tier) ──────────────────────────────────────────
# Smart model — final synthesis, judge, planner
GROQ_MODEL_SMART=llama-3.3-70b-versatile
# Fast model — query rewriting, reranking, lightweight sub-tasks
GROQ_MODEL_FAST=llama-3.1-8b-instant
# Vision model — table/figure captioning at ingest
# (Verify availability in your Groq console; fall back to local unstructured.io if unavailable)
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct

# ─── Embeddings (local, free) ────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ─── Retrieval tuning ────────────────────────────────────────────────────────
TOP_K_RETRIEVE=20
TOP_K_RERANK=6
